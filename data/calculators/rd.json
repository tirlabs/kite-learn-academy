{
  "id": "rd",
  "title": "RD Calculator",
  "description": "Estimate recurring-deposit maturity from regular monthly deposits.",
  "category": "personal",
  "assumptions": "Models month-end deposits using an effective monthly rate equivalent to quarterly compounding. Bank RD conventions may differ.",
  "fields": [
    {
      "name": "monthlyDeposit",
      "label": "Monthly deposit",
      "unit": "₹",
      "default": 5000,
      "min": 1,
      "max": 100000000,
      "step": 500
    },
    {
      "name": "annualRate",
      "label": "Annual interest rate",
      "unit": "%",
      "default": 6.5,
      "min": 0,
      "max": 30,
      "step": 0.1
    },
    {
      "name": "years",
      "label": "Deposit period",
      "unit": "Years",
      "default": 5,
      "min": 1,
      "max": 20,
      "step": 1
    }
  ]
}
