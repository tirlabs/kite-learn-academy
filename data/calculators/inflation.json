{
  "id": "inflation",
  "title": "Inflation Calculator",
  "description": "See how inflation may change the future cost of something.",
  "category": "personal",
  "assumptions": "Uses a constant assumed annual inflation rate. Actual inflation varies over time and across goods and services.",
  "fields": [
    {
      "name": "currentCost",
      "label": "Cost today",
      "unit": "₹",
      "default": 10000,
      "min": 0.01,
      "max": 1000000000,
      "step": 100
    },
    {
      "name": "inflationRate",
      "label": "Assumed annual inflation",
      "unit": "%",
      "default": 6,
      "min": 0,
      "max": 100,
      "step": 0.5
    },
    {
      "name": "years",
      "label": "Time period",
      "unit": "Years",
      "default": 10,
      "min": 1,
      "max": 100,
      "step": 1
    }
  ]
}
