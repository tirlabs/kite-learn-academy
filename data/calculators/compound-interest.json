{
  "id": "compound-interest",
  "title": "Compound Interest Calculator",
  "description": "Explore how principal and accumulated interest may grow with compounding.",
  "category": "investment",
  "assumptions": "Assumes a constant rate and the selected compounding frequency. Contributions and withdrawals are not included.",
  "fields": [
    {
      "name": "principal",
      "label": "Initial principal",
      "unit": "₹",
      "default": 100000,
      "min": 1,
      "max": 1000000000,
      "step": 1000
    },
    {
      "name": "annualRate",
      "label": "Annual interest rate",
      "unit": "%",
      "default": 8,
      "min": 0,
      "max": 100,
      "step": 0.5
    },
    {
      "name": "years",
      "label": "Time period",
      "unit": "Years",
      "default": 10,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "name": "frequency",
      "label": "Compounding frequency",
      "unit": "Times per year",
      "default": 4,
      "min": 1,
      "max": 365,
      "step": 1
    }
  ]
}
