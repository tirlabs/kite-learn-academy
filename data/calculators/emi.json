{
  "id": "emi",
  "title": "EMI Calculator",
  "description": "Estimate monthly loan instalments and total interest.",
  "category": "personal",
  "assumptions": "Assumes a fixed interest rate and equal monthly instalments. Actual lender fees, rate resets and repayment schedules may differ.",
  "fields": [
    {
      "name": "principal",
      "label": "Loan amount",
      "unit": "₹",
      "default": 2500000,
      "min": 1,
      "max": 1000000000,
      "step": 10000
    },
    {
      "name": "annualRate",
      "label": "Annual interest rate",
      "unit": "%",
      "default": 9,
      "min": 0,
      "max": 50,
      "step": 0.25
    },
    {
      "name": "months",
      "label": "Loan tenure",
      "unit": "Months",
      "default": 240,
      "min": 1,
      "max": 600,
      "step": 1
    }
  ]
}
